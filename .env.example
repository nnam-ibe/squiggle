# Copy to .env.local and fill in. Postgres connection string for Drizzle.
# Local example:   postgresql://USER@localhost:5432/squiggle
# Neon/Supabase:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Secret used to hash uploader IPs for rate limiting (any random string).
IP_HASH_SALT=
